{
  "name": "wardrobe",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first AI wardrobe for the web and iOS, powered by Gemini.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @wardrobe/server",
    "dev:web": "npm run dev -w @wardrobe/web",
    "ios": "npm run ios -w @wardrobe/mobile",
    "build": "npm run build -w @wardrobe/web",
    "start": "npm run start -w @wardrobe/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
