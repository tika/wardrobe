{
  "name": "wardrobe",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first AI wardrobe for the web and iOS, powered by Gemini.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @wardrobe/server --filter @wardrobe/web dev",
    "ios": "bun run --filter @wardrobe/mobile ios",
    "build": "bun run --filter @wardrobe/web build",
    "start": "bun run --filter @wardrobe/server start",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run typecheck && bun run build",
    "image:generate": "bun apps/server/src/cli/generate-image.ts",
    "image:remove-background": "bun apps/server/src/cli/remove-background.ts",
    "library:import": "bun apps/server/src/cli/import-library.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "packageManager": "bun@1.3.9"
}
