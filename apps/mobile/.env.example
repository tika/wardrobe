# The same service token as CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET in the root .env.
# Without it the app can only reach a local `bun run dev` server.
EXPO_PUBLIC_CF_ACCESS_CLIENT_ID=
EXPO_PUBLIC_CF_ACCESS_CLIENT_SECRET=
# Defaults to the dev server in development and https://wardrobe.capon.io otherwise.
# EXPO_PUBLIC_API_URL=
