# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The one email Cloudflare Access lets in (sign-in codes are sent here).
WARDROBE_OWNER_EMAIL=

# Service token for the agent CLIs (printed by `bun run deploy`).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Where the CLIs send requests; use http://localhost:4747 with `bun run dev`.
# WARDROBE_API_URL=https://wardrobe.capon.io

# Optional model overrides
# GEMINI_IMAGE_MODEL=gemini-3-pro-image   # Nano Banana Pro; gemini-nano-banana-2.1 is faster and cheaper
# GEMINI_VISION_MODEL=gemini-3.8-flash
